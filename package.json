{
  "name": "campus-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n backend,app-ui -c blue,green \"npm --prefix backend run dev\" \"cd \"App Ui\" && npm run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "cd \"App Ui\" && npm run dev",
    "build": "cd \"App Ui\" && npm run build",
    "start": "npm --prefix backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
