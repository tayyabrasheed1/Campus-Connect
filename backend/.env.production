PORT=5000
NODE_ENV=production
# For Vercel production, these need to be set in the Vercel dashboard
MONGO_URI=your_mongodb_atlas_uri_here
JWT_SECRET=your_secure_jwt_secret_key_must_be_strong
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
FRONTEND_URL=https://your-domain.vercel.app
ADMIN_EMAILS=admin@example.com
STUDENT_DOMAINS=example-college.edu.pk
FACULTY_DOMAINS=faculty.example-college.edu.pk
ALUMNI_DOMAINS=alumni.example-college.edu.pk
FACULTY_EMAIL_HINTS=faculty,prof,lecturer,hod
ALUMNI_EMAIL_HINTS=alumni,grad
