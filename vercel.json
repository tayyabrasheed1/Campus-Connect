{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "nodeVersion": "20.x",
  "installCommand": "npm install && npm --prefix \"App Ui\" install && npm --prefix backend install",
  "buildCommand": "npm --prefix \"App Ui\" run build",
  "outputDirectory": "App Ui/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
