{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "App Ui",
      "config": {
        "framework": "vite",
        "buildCommand": "npm run build",
        "installCommand": "npm install",
        "outputDirectory": "dist"
      }
    },
    "backend": {
      "entrypoint": "backend",
      "config": {
        "runtime": "nodejs20.x",
        "buildCommand": "npm install",
        "installCommand": "npm install"
      }
    }
  },
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
