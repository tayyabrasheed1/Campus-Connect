{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "App Ui",
      "config": {
        "runtime": "nodejs20.x"
      }
    },
    "backend": {
      "entrypoint": "backend",
      "config": {
        "runtime": "nodejs20.x"
      }
    }
  },
  "buildCommand": "npm --prefix 'App Ui' run build",
  "installCommand": "npm install && npm --prefix backend install && npm --prefix 'App Ui' install",
  "outputDirectory": "App Ui/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
